# Database connection string
# For PostgreSQL (default production/dev):
DATABASE_URL=postgresql+psycopg://postgres:postgres@localhost:5432/ripple
# For SQLite (zero-config local fallback / testing):
# DATABASE_URL=sqlite:///./ripple.db

# JWT Authentication
JWT_SECRET=super-secret-ripple-jwt-key-change-in-production-2026
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=1440

# CORS Configuration (comma-separated list of origins)
CORS_ORIGINS=http://localhost:3000,http://localhost:5173,http://localhost:8080,http://127.0.0.1:3000,http://127.0.0.1:5173,http://127.0.0.1:8080

# Environment
ENVIRONMENT=development
PORT=8000
HOST=0.0.0.0
