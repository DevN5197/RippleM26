# Ripple Frontend Environment Variables

# Choose data mode: "api" (connect to live FastAPI backend) or "mock" (in-memory demo data)
VITE_DATA_MODE=api

# FastAPI backend base URL
VITE_API_BASE_URL=http://127.0.0.1:8000

# Google AI Studio API Key for Insights & AI Copilot (Gemini 2.5 Flash)
# Optional: Can also be configured directly in-app or overridden via Settings (localStorage)
VITE_GEMINI_API_KEY=
